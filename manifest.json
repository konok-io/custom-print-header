{
  "manifest_version": 3,
  "name": "বিন মিশাল প্রিন্ট লেআউট",
  "version": "2.0.0",
  "description": "যেকোনো ওয়েবপেজ প্রিন্টে কাস্টম হেডার ও ফুটার — বাংলা ফন্ট সহ। Developed by konok.io",
  "author": "konok.io",
  "homepage_url": "https://www.konok.io",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "বিন মিশাল প্রিন্ট লেআউট",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*.ttf", "fonts/*.woff", "fonts/*.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
